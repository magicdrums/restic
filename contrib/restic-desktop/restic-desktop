import sys
from pathlib import Path

# Soporte ejecución sin instalar (desde el directorio del proyecto)
_root = Path(__file__).resolve().parent
if (_root / "restic_desktop").is_dir():
    sys.path.insert(0, str(_root))

from restic_desktop.app import main

if __name__ == "__main__":
    raise SystemExit(main())
